# Privy app id enables "Continue with Google / X" with an embedded wallet made at sign-in.
# Create one at dashboard.privy.io, enable Google + Twitter login and add Robinhood Chain.
# Leave empty to offer browser wallets only.
VITE_PRIVY_APP_ID=
VITE_CHAIN_ID=4663
VITE_RPC_URL=https://rpc.mainnet.chain.robinhood.com
VITE_EXPLORER_URL=https://robinhoodchain.blockscout.com
# 1 = relaxed rules and "tap the map to walk there" for testing on a laptop. Match the server's TEST_MODE.
VITE_TEST_MODE=0
