# ── server ──
PORT=8787
PUBLIC_ORIGIN=http://localhost:5173        # exact origin of the web app (SIWE domain + CORS)
SESSION_SECRET=                            # 32+ random chars; required in production
DB_PATH=./data/streetstock.db
TRUST_PROXY=0                              # 1 behind a reverse proxy, so rate limits see real IPs
TEST_MODE=0                                # 1 = tiny rings, no cooldown, no motion check: laptop testing only

# ── Robinhood Chain (docs.robinhood.com/chain/connecting) ──
CHAIN_ID=4663                              # 46630 for testnet
RPC_URL=https://rpc.mainnet.chain.robinhood.com
EXPLORER_URL=https://robinhoodchain.blockscout.com

# ── contracts (from `forge script script/Deploy.s.sol`) ──
DROP_VAULT=
FEE_SPLITTER=
WALK_TOKEN=
KEEPER_PRIVATE_KEY=                        # hot key: can only pay capped catches; fund it with a little ETH for gas
ETH_USD_FEED=

# ── stocks: address from the on-chain asset registry (docs.robinhood.com/chain/contracts),
#    feed from docs.chain.link/data-feeds/price-feeds/addresses?network=robinhood
#    Never copy a ticker's address from an explorer search: copies exist. ListStock.s.sol verifies uiMultiplier().
STOCK_NVDA_ADDRESS=
STOCK_NVDA_FEED=
STOCK_TSLA_ADDRESS=
STOCK_TSLA_FEED=
STOCK_AAPL_ADDRESS=
STOCK_AAPL_FEED=
STOCK_AMZN_ADDRESS=
STOCK_AMZN_FEED=
STOCK_META_ADDRESS=
STOCK_META_FEED=

# With any of DROP_VAULT / KEEPER_PRIVATE_KEY / a stock missing, the server runs in DEMO mode:
# the whole game works, catches are recorded, nothing moves on chain.
DEMO_VAULT_USD=400
LEGENDARY_PEPPER=                          # random; the legendary code is stored only as an HMAC with this
